YOUCAM_API_KEY=your_youcam_api_key_here
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com/s2s
JWT_SECRET=supersecret_change_me_in_production
DATABASE_URL=sqlite:///../pov.db

# ── Recommendation Engine ────────────────────────────────────────────────────
# "hybrid" (default) | "ml" | "rule"
RECOMMENDATION_ENGINE=hybrid
# Path to the trained LightGBM model file (relative to project root)
ML_MODEL_PATH=models/pov_fit_model.txt
# Minimum ML confidence score (0–1) to use ML result; otherwise falls back to rules
ML_MIN_CONFIDENCE=0.55
# Percentage of users routed to ML/hybrid engine (0–100). Use 10 for gradual rollout.
ML_ROLLOUT_PERCENTAGE=100
