YOUCAM_API_KEY=your_youcam_api_key_here
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com/s2s
JWT_SECRET=supersecret_change_me_in_production
DATABASE_URL=sqlite:///../pov.db

# ── Qloo Cultural Intelligence API ───────────────────────────────────────────
QLOO_API_KEY=
QLOO_API_BASE_URL=https://api.qloo.com
QLOO_SANDBOX_MODE=true

# ── Recommendation Engine ────────────────────────────────────────────────────
# "hybrid" (default) | "ml" | "rule"
RECOMMENDATION_ENGINE=hybrid
# Path to the trained LightGBM model file (relative to project root)
ML_MODEL_PATH=models/pov_fit_model.txt
# Minimum ML confidence score (0–1) to use ML result; otherwise falls back to rules
ML_MIN_CONFIDENCE=0.55
# Percentage of users routed to ML/hybrid engine (0–100). Use 10 for gradual rollout.
ML_ROLLOUT_PERCENTAGE=100

# ── Gemini Agentic Intelligence Layer ────────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Set to false to disable Gemini and use deterministic-only mode
GEMINI_AGENT_ENABLED=true
# Model to use — gemini-2.0-flash is fast and free-tier friendly
GEMINI_MODEL=gemini-2.0-flash
# Seconds to wait for Gemini before falling back to deterministic result
GEMINI_TIMEOUT_SECONDS=15
# Max retries on transient errors (quota errors are NEVER retried)
GEMINI_MAX_RETRIES=1
